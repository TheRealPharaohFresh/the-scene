rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isExistingConversationMember() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }

    function isNewConversationMember() {
      return signedIn() && request.auth.uid in request.resource.data.memberIds;
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    match /likes/{likeId} {
      allow read: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow update: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read, update: if isExistingConversationMember();
      allow create: if isNewConversationMember();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isExistingConversationMember();
        allow create: if isExistingConversationMember()
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /notifications/{uid}/items/{notificationId} {
      allow read, update, delete: if isOwner(uid);
      allow create: if false;
    }

    match /subscriptions/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /blocks/{blockId} {
      allow read, delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }
  }
}
