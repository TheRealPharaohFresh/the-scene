rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validLink(value) {
      return value is string
        && value.size() <= 2048
        && (value == '' || value.matches('https://.*') || value.matches('http://.*'));
    }

    function validRoles(category, roles) {
      return roles is list
        && roles.size() <= 20
        && roles.toSet().size() == roles.size()
        && (
          (category == 'Music' && roles.hasOnly([
            'Producer', 'Songwriter', 'Artist', 'DJ', 'Audio Engineer', 'Mix Engineer',
            'Mastering Engineer', 'Music Supervisor', 'A&R', 'Manager', 'Publisher'
          ]))
          || (category == 'Television' && roles.hasOnly([
            'Actor', 'Director', 'Writer', 'Producer', 'Editor', 'Cinematographer', 'Showrunner'
          ]))
          || (category == 'Film' && roles.hasOnly([
            'Actor', 'Director', 'Writer', 'Producer', 'Editor', 'Cinematographer', 'Composer',
            'Production Designer', 'VFX Artist', 'Casting Director'
          ]))
          || (category == 'Comedy' && roles.hasOnly([
            'Stand Up Comedian', 'Writer', 'Actor', 'Creator', 'Podcast Host'
          ]))
          || (category == 'Social Media' && roles.hasOnly([
            'Creator', 'Influencer', 'Content Strategist', 'Community Manager', 'Video Editor',
            'Social Media Manager'
          ]))
          || (category == 'Gaming' && roles.hasOnly([
            'Streamer', 'Game Developer', 'Esports Athlete', 'Game Designer', 'Community Manager',
            'Caster', 'Content Creator'
          ]))
          || (category == 'Theater' && roles.hasOnly([
            'Actor', 'Director', 'Playwright', 'Stage Manager', 'Lighting Designer',
            'Costume Designer', 'Choreographer'
          ]))
          || (category == 'Fashion' && roles.hasOnly([
            'Model', 'Designer', 'Stylist', 'Photographer', 'Makeup Artist', 'Brand Strategist',
            'Fashion Blogger'
          ]))
          || (category == 'Dance' && roles.hasOnly([
            'Dancer', 'Choreographer', 'Instructor', 'Creative Director', 'Movement Coach'
          ]))
          || (category == 'Photography' && roles.hasOnly([
            'Photographer', 'Photo Editor', 'Producer', 'Creative Director', 'Retoucher'
          ]))
          || (category == 'Other' && roles.hasOnly([
            'Creative Consultant', 'Talent Manager', 'Event Producer', 'Publicist', 'Writer'
          ]))
        );
    }

    function validProfile(uid) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId',
          'displayName',
          'gender',
          'entertainmentCategory',
          'roles',
          'bio',
          'portfolioUrl',
          'socialMedia',
          'lookingFor',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'displayName',
          'nickname',
          'gender',
          'entertainmentCategory',
          'roles',
          'bio',
          'stateCode',
          'city',
          'location',
          'portfolioUrl',
          'socialMedia',
          'lookingFor',
          'createdAt',
          'profilePhotoUrl',
          'coverPhotoUrl'
        ])
        && data.userId == uid
        && data.displayName is string
        && data.displayName.size() <= 50
        && (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 50))
        && data.gender in ['Male', 'Female', 'Non-binary', 'Prefer not to say']
        && data.entertainmentCategory in [
          'Music',
          'Television',
          'Film',
          'Comedy',
          'Social Media',
          'Gaming',
          'Theater',
          'Fashion',
          'Dance',
          'Photography',
          'Other'
        ]
        && validRoles(data.entertainmentCategory, data.roles)
        && data.bio is string
        && data.bio.size() <= 1500
        && (!('stateCode' in data) || data.stateCode in [
          '',
          'AL',
          'AK',
          'AZ',
          'AR',
          'CA',
          'CO',
          'CT',
          'DE',
          'DC',
          'FL',
          'GA',
          'HI',
          'ID',
          'IL',
          'IN',
          'IA',
          'KS',
          'KY',
          'LA',
          'ME',
          'MD',
          'MA',
          'MI',
          'MN',
          'MS',
          'MO',
          'MT',
          'NE',
          'NV',
          'NH',
          'NJ',
          'NM',
          'NY',
          'NC',
          'ND',
          'OH',
          'OK',
          'OR',
          'PA',
          'RI',
          'SC',
          'SD',
          'TN',
          'TX',
          'UT',
          'VT',
          'VA',
          'WA',
          'WV',
          'WI',
          'WY',
          'AS',
          'GU',
          'MP',
          'PR',
          'UM',
          'VI'
        ])
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('location' in data) || (data.location is string && data.location.size() <= 120))
        && validLink(data.portfolioUrl)
        && data.socialMedia is map
        && data.socialMedia.keys().hasOnly(['instagram', 'tiktok', 'youtube', 'twitter', 'website'])
        && (!('instagram' in data.socialMedia) || validLink(data.socialMedia.instagram))
        && (!('tiktok' in data.socialMedia) || validLink(data.socialMedia.tiktok))
        && (!('youtube' in data.socialMedia) || validLink(data.socialMedia.youtube))
        && (!('twitter' in data.socialMedia) || validLink(data.socialMedia.twitter))
        && (!('website' in data.socialMedia) || validLink(data.socialMedia.website))
        && data.lookingFor is list
        && data.lookingFor.size() <= 3
        && data.lookingFor.toSet().size() == data.lookingFor.size()
        && data.lookingFor.hasOnly(['Friends', 'Networking', 'Relationship'])
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && (!('profilePhotoUrl' in data) || validLink(data.profilePhotoUrl))
        && (!('coverPhotoUrl' in data) || validLink(data.coverPhotoUrl));
    }

    // Must mirror the owner's private profile, which is written in the same
    // batch (getAfter) or already exists. This keeps the public copy limited to
    // data the owner already validated, and rejects a public doc without a profile.
    // Links are only present when shared, and must equal the private profile's links.
    function validPublicLinks(data, privateData) {
      return ('links' in data) == ('links' in data.shared)
        && (!('links' in data)
          || (data.links.keys().hasOnly(['portfolioUrl', 'socialMedia'])
            && data.links.portfolioUrl == privateData.get('portfolioUrl', '')
            && data.links.socialMedia == privateData.get('socialMedia', {})));
    }

    function validPublicProfile(uid) {
      let data = request.resource.data;
      let profilePath = /databases/$(database)/documents/profiles/$(uid);
      return existsAfter(profilePath)
        && data.keys().hasOnly([
          'userId',
          'displayName',
          'entertainmentCategory',
          'roles',
          'bio',
          'stateCode',
          'city',
          'lookingFor',
          'discoverable',
          'shared',
          'links',
          'createdAt',
          'profilePhotoUrl',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'userId',
          'displayName',
          'entertainmentCategory',
          'roles',
          'bio',
          'stateCode',
          'city',
          'lookingFor',
          'discoverable',
          'shared',
          'createdAt',
          'updatedAt'
        ])
        && data.userId == uid
        && data.discoverable is bool
        && data.shared is list
        && data.shared.size() <= 4
        && data.shared.hasOnly(['bio', 'location', 'lookingFor', 'links'])
        && data.updatedAt == request.time
        && data.displayName == getAfter(profilePath).data.displayName
        && data.entertainmentCategory == getAfter(profilePath).data.entertainmentCategory
        && data.roles == getAfter(profilePath).data.roles
        && data.bio == ('bio' in data.shared ? getAfter(profilePath).data.bio : '')
        && data.stateCode == getAfter(profilePath).data.get('stateCode', '')
        && data.city == ('location' in data.shared ? getAfter(profilePath).data.get('city', '') : '')
        && data.lookingFor == ('lookingFor' in data.shared ? getAfter(profilePath).data.lookingFor : [])
        && validPublicLinks(data, getAfter(profilePath).data)
        && data.createdAt == getAfter(profilePath).data.createdAt
        && data.get('profilePhotoUrl', '') == getAfter(profilePath).data.get('profilePhotoUrl', '');
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'email',
          'firstName',
          'lastName',
          'adultAttested',
          'adultAttestedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.adultAttested == true
        && request.resource.data.adultAttestedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'firstName', 'lastName', 'updatedAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 30
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /profiles/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile(uid);
      allow update: if isOwner(uid)
        && validProfile(uid)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if false;
    }

    // Public projection of a profile. Members read only documents whose owner
    // opted in; queries must therefore filter on discoverable == true.
    match /publicProfiles/{uid} {
      allow read: if isOwner(uid)
        || (signedIn() && resource.data.discoverable == true);
      allow create, update: if isOwner(uid) && validPublicProfile(uid);
      allow delete: if false;
    }

    // Private like/pass decisions. Only the owner can read or write them; mutual-match
    // detection will need a trusted backend (see roadmap Phase 5) and is not implemented.
    match /swipes/{uid}/items/{targetId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && targetId != uid
        && request.resource.data.keys().hasOnly(['targetId', 'action', 'createdAt'])
        && request.resource.data.targetId == targetId
        && request.resource.data.action in ['like', 'pass']
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }

    match /likes/{likeId} {
      allow read, write: if false;
    }

    match /matches/{matchId} {
      allow read, write: if false;
    }

    match /conversations/{conversationId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    match /notifications/{uid}/items/{notificationId} {
      allow read, write: if false;
    }

    match /subscriptions/{uid} {
      allow read, write: if false;
    }

    // ---- Community: forum threads, groups, events, reports, blocks ----

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    // Author names are checked against the author's real profile so they cannot be spoofed.
    function authorNameMatches(uid, name) {
      return exists(profilePath(uid)) && name == get(profilePath(uid)).data.displayName;
    }

    function groupPath(gid) {
      return /databases/$(database)/documents/groups/$(gid);
    }

    function isGroupMember(gid) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    function canSeeThread(thread) {
      return thread.groupId == null || isGroupMember(thread.groupId);
    }

    match /threads/{threadId} {
      allow read: if signedIn() && canSeeThread(resource.data);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'title', 'body', 'groupId', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && authorNameMatches(request.auth.uid, request.resource.data.authorName)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 140
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 5000
        && (request.resource.data.groupId == null
          || (request.resource.data.groupId is string && isGroupMember(request.resource.data.groupId)))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /replies/{replyId} {
        allow read: if signedIn() && canSeeThread(get(/databases/$(database)/documents/threads/$(threadId)).data);
        allow create: if signedIn()
          && canSeeThread(get(/databases/$(database)/documents/threads/$(threadId)).data)
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'body', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && authorNameMatches(request.auth.uid, request.resource.data.authorName)
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 3000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    match /groups/{gid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerId', 'name', 'description', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 600
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /members/{uid} {
        allow read: if isGroupMember(gid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['userId', 'displayName', 'role', 'joinedAt'])
          && request.resource.data.userId == uid
          && authorNameMatches(uid, request.resource.data.displayName)
          && request.resource.data.joinedAt == request.time
          && ((request.resource.data.role == 'member' && exists(groupPath(gid)))
            || (request.resource.data.role == 'owner'
              && existsAfter(groupPath(gid))
              && getAfter(groupPath(gid)).data.ownerId == uid));
        allow update: if false;
        allow delete: if isOwner(uid) && resource.data.role != 'owner';
      }

      match /events/{eventId} {
        allow read: if isGroupMember(gid);
        allow create: if isGroupMember(gid)
          && request.resource.data.keys().hasOnly(['hostId', 'hostName', 'title', 'description', 'kind', 'startsAt', 'city', 'stateCode', 'createdAt'])
          && request.resource.data.hostId == request.auth.uid
          && authorNameMatches(request.auth.uid, request.resource.data.hostName)
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1200
          && request.resource.data.kind in ['Music video', 'Film shoot', 'Photo shoot', 'Audition / casting', 'Meetup', 'Other']
          && request.resource.data.startsAt is timestamp
          && request.resource.data.startsAt > request.time
          && request.resource.data.city is string
          && request.resource.data.city.size() <= 80
          && request.resource.data.stateCode is string
          && request.resource.data.stateCode.size() <= 4
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isGroupMember(gid) && resource.data.hostId == request.auth.uid;

        // Exact address: visible only to the host and members who RSVP'd "going".
        match /private/{detailId} {
          allow read: if isGroupMember(gid)
            && (get(/databases/$(database)/documents/groups/$(gid)/events/$(eventId)).data.hostId == request.auth.uid
              || (exists(/databases/$(database)/documents/groups/$(gid)/events/$(eventId)/rsvps/$(request.auth.uid))
                && get(/databases/$(database)/documents/groups/$(gid)/events/$(eventId)/rsvps/$(request.auth.uid)).data.status == 'going'));
          allow create: if isGroupMember(gid)
            && detailId == 'details'
            && existsAfter(/databases/$(database)/documents/groups/$(gid)/events/$(eventId))
            && getAfter(/databases/$(database)/documents/groups/$(gid)/events/$(eventId)).data.hostId == request.auth.uid
            && request.resource.data.keys().hasOnly(['address'])
            && request.resource.data.address is string
            && request.resource.data.address.size() <= 240;
          allow update, delete: if false;
        }

        match /rsvps/{uid} {
          allow read: if isGroupMember(gid);
          allow create, update: if isOwner(uid)
            && isGroupMember(gid)
            && request.resource.data.keys().hasOnly(['userId', 'displayName', 'status', 'updatedAt'])
            && request.resource.data.userId == uid
            && authorNameMatches(uid, request.resource.data.displayName)
            && request.resource.data.status in ['going', 'maybe', 'declined']
            && request.resource.data.updatedAt == request.time;
          allow delete: if isOwner(uid);
        }
      }
    }

    // Write-only for members; reviewing reports needs a trusted moderation tool (roadmap Phase 7).
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterId', 'targetType', 'targetPath', 'reason', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['thread', 'reply', 'group', 'event', 'member']
        && request.resource.data.targetPath is string
        && request.resource.data.targetPath.size() <= 200
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt == request.time;
    }

    // Private block list. Blocked members are hidden client-side in the forum and Discover.
    match /blocks/{uid}/items/{targetId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && targetId != uid
        && request.resource.data.keys().hasOnly(['targetId', 'createdAt'])
        && request.resource.data.targetId == targetId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner(uid);
    }
  }
}
